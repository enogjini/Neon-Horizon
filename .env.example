# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/frappe

# Redis
# Point this at your Redis instance for real persistence.
# Upstash example: rediss://:YOUR_PASSWORD@YOUR_ENDPOINT:6379
REDIS_URL=
UPSTASH_REDIS_URL=rediss://:YOUR_PASSWORD@YOUR_ENDPOINT:6379
# Optional: tune or disable the confirmation email worker.
# EMAIL_WORKER_POLL_MS=5000
# EMAIL_INLINE_DRAIN_LIMIT=3
# EMAIL_WORKER_DISABLED=false

# Webhook (local mock processor)
WEBHOOK_SECRET=dev-secret

# Order confirmation emails — first match wins: Mailgun → Brevo → SendGrid → generic SMTP → Ethereal

# Verified sender / From address (required for real delivery with any provider)
FROM_EMAIL=tickets@your-verified-domain.com

# Option A: Mailgun (recommended for this project)
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.your-domain.com
# MAILGUN_BASE_URL=https://api.mailgun.net
# MAILGUN_REGION=us
# MAILGUN_FROM_EMAIL=tickets@mg.your-domain.com

# Option B: Brevo (https://app.brevo.com/ → SMTP & API → SMTP)
# SMTP key = password (starts with xsmtpsib-…). Not the REST “API v3” key.
# You can use BREVO_SMTP_PASSWORD instead of BREVO_SMTP_KEY if you prefer.
BREVO_SMTP_KEY=
BREVO_SMTP_LOGIN=
# Optional: 587 (default), 2525, or 465
# BREVO_SMTP_PORT=587

# Option B: SendGrid
# SENDGRID_API_KEY=

# Option C: Any SMTP provider (Resend, Mailgun, etc.)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# If none of the above is set, mail goes to Ethereal (fake inbox).
# After a purchase, check server logs for: [mailer] dev inbox — preview: https://...
